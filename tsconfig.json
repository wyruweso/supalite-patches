{
   "compilerOptions": {
      "target": "es2022",
      "module": "nodenext",
      "moduleResolution": "nodenext",
      "lib": ["es2023", "dom"],
      "types": ["node"],
      "strict": true,
      "noEmit": true,
      "allowImportingTsExtensions": true,
      "erasableSyntaxOnly": true,
      "skipLibCheck": true
   },
   "include": ["lib/**/*.ts", "test/**/*.ts", "*.ts"]
}
